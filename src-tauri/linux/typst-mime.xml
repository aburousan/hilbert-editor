<?xml version="1.0" encoding="UTF-8"?>
<!-- Recent shared-mime-info defines this type, but older distributions ship
     without it, and there the file manager has no type for *.typ to match the
     launcher's MimeType against, so Open With never offers Hilbert. Same name
     and alias as upstream, so a newer database simply agrees with it. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/vnd.typst">
    <sub-class-of type="text/plain"/>
    <comment>Typst document</comment>
    <alias type="text/x-typst"/>
    <glob pattern="*.typ"/>
  </mime-type>
</mime-info>
